{
  "name": "deyloom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Deyloom — a React UI library built around one unified motion language.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev -w @deyloom/docs",
    "build": "npm run build -w @deyloom/react",
    "build:docs": "npm run build -w @deyloom/docs",
    "preview": "npm run preview -w @deyloom/docs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @deyloom/react",
    "guard": "node scripts/check-motion-css.mjs",
    "size": "node scripts/check-size.mjs",
    "smoke": "node scripts/smoke-package.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run guard && npm run size && npm run smoke && npm run build:docs",
    "e2e": "npm run build && npm run size && npm run build:docs && playwright test",
    "e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0"
  }
}
